{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "MarketSettings": {
      "title": "MarketSettings",
      "description": "Settings for market list",
      "type": "object",
      "properties": {
        "list": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/MarketSettings" },
      "description": "Settings configuration"
    }
  }
}
